TELEGRAM_BOT_TOKEN=123456789:YOUR_TOKEN
TELEGRAM_BOT_USERNAME=your_bot_username

KIE_API_KEY=kie_your_api_key

# Канал, подписка на который обязательна: @username или -100...
REQUIRED_CHANNEL_ID=@your_channel
REQUIRED_CHANNEL_URL=https://t.me/your_channel

# Первый админ (необязательно)
INITIAL_ADMIN_ID=123456789

# Глобальный лимит генераций в день (МСК)
DEFAULT_DAILY_LIMIT=20

# База данных
DB_PATH=./data/bot.db

# Поллинг KIE task endpoint
KIE_POLL_ATTEMPTS=40
KIE_POLL_DELAY_MS=1800

# При необходимости можно переопределить endpoints
KIE_GEMINI_ENDPOINT=https://api.kie.ai/gemini-3-flash/v1/chat/completions
KIE_CREATE_TASK_ENDPOINT=https://api.kie.ai/api/v1/jobs/createTask
KIE_RECORD_INFO_ENDPOINT=https://api.kie.ai/api/v1/jobs/recordInfo
KIE_FILE_UPLOAD_ENDPOINT=https://kieai.redpandaai.co/api/file-base64-upload
